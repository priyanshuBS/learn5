# Copy this file to .env.local and fill in real values. No value may be empty.

# ── Server secrets (never prefix with EXPO_PUBLIC_, never commit) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string
# Resend API key (https://resend.com) and a sender on your verified domain.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Learn5 <no-reply@email.priyanshusingh.co.in>
# Groq key for the daily question generator (https://console.groq.com/keys).
GROQ_API_KEY=gsk_your_groq_api_key
# Optional: which Groq model writes the questions (default openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# ── App settings (public: copied into the app) ──
EXPO_PUBLIC_APP_URL=https://learn5.priyanshusingh.co.in
EXPO_PUBLIC_REPORT_EMAIL=support@priyanshusingh.co.in
