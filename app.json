{
  "expo": {
    "name": "Learn5",
    "slug": "learn5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "learn5",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "in.priyanshusingh.learn5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E5BDA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.priyanshusingh.learn5"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "name": "Learn5",
      "shortName": "Learn5",
      "description": "5 questions. 5 minutes. Get smarter every day.",
      "themeColor": "#111113",
      "backgroundColor": "#111113"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111113",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2E5BDA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "5 questions. 5 minutes. Learn a little every day.",
    "extra": {
      "router": {
        "apiRoutes": true,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e808c8b0-34fc-483a-a1aa-4084e3261a25"
      }
    }
  }
}
